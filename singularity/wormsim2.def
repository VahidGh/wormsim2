Bootstrap: docker
From: nvidia/cuda:12.4.0-devel-ubuntu22.04

# wormsim2 Apptainer/Singularity image (v0.11.0)
# ─────────────────────────────────────────────────
# Reproducible container for HPC deployment on CINECA G100 (V100S, CUDA 12.4)
# and any SLURM cluster with Apptainer ≥ 1.1.
#
# Build (CI — GitHub Actions slurm-deploy.yml):
#   apptainer build wormsim2.sif singularity/wormsim2.def
#
# Build (local, Linux only — macOS needs a VM):
#   sudo apptainer build wormsim2.sif singularity/wormsim2.def
#
# Run benchmark (SLURM — see scripts/slurm/wormsim2_benchmark.sbatch):
#   apptainer run --nv wormsim2.sif python3 /opt/wormsim2/scripts/benchmark.py
#
# Inspect:
#   apptainer inspect wormsim2.sif
#
# References:
#   Lec 13 (13.Containers.pdf) — Singularity/Apptainer for HPC reproducibility
#   CINECA G100: g100.cineca.it  partition g100_usr_prod  (Tesla V100S 32 GB)

%labels
    Author          VahidGh / wormsim2
    Version         0.11.0
    Description     wormsim2 C. elegans simulator — benchmark container
    CUDA_Version    12.4
    OpenMP          enabled
    JAX_Backend     jax[cuda12]

%environment
    export WORMSIM2_SRC=/opt/wormsim2
    export PATH=/opt/wormsim2/build:$PATH
    export PYTHONPATH=/opt/wormsim2/src/python:$PYTHONPATH
    export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-4}
    export JAX_PLATFORMS=cuda,cpu

%files
    # Embed Python source so %test can import it without a bind-mount.
    # Paths are relative to the directory where `apptainer build` is invoked
    # (repo root in CI; use `apptainer build --bind` for local builds).
    src/python /opt/wormsim2/src/python

%post
    export DEBIAN_FRONTEND=noninteractive

    # ── System packages ──────────────────────────────────────────────────────
    apt-get update -qq && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git pkg-config ca-certificates \
        libgomp1 libomp-dev \
        opencl-headers ocl-icd-opencl-dev ocl-icd-libopencl1 \
        python3 python3-pip python3-dev \
        && rm -rf /var/lib/apt/lists/*

    # ── Python stack ─────────────────────────────────────────────────────────
    pip3 install --no-cache-dir \
        "jax[cuda12]" \
        numpy scipy pandas matplotlib joblib \
        plotly kaleido pillow \
        pyopencl

    # ── Copy source and build ─────────────────────────────────────────────────
    mkdir -p /opt/wormsim2
    # Source is embedded at build time; at runtime the repo is bind-mounted.
    # The build below is a fallback; production CI injects the pre-built binary.

%runscript
    #!/bin/bash
    exec python3 /opt/wormsim2/scripts/benchmark.py "$@"

%test
    # %environment is NOT sourced during build, so use literal paths here.
    python3 -c "import jax; print('JAX OK:', jax.devices())"
    python3 -c "
import sys
sys.path.insert(0, '/opt/wormsim2/src/python')
from hardware import detect_hardware
print(detect_hardware().summary())
"
